#!/bin/sh
# Actualiza la IP pública del subdominio en Duck DNS.
# Copiar a ~/duckdns/duck.sh, reemplazar los valores, y proteger con: chmod 700 ~/duckdns/duck.sh
# Cron (cada 5 minutos):  */5 * * * * ~/duckdns/duck.sh >/dev/null 2>&1
# NUNCA subir el token real al repositorio.
echo url="https://www.duckdns.org/update?domains=YOUR-SUBDOMAIN&token=YOUR_DUCKDNS_TOKEN&ip=" \
  | curl -k -o ~/duckdns/duck.log -K -
